# Copy this file to .env and fill in values locally. Never commit .env.
API_KEY=
BASE_URL=https://api.example.com/v1
MODEL=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query
NORMALIZE_EMBEDDINGS=true
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.45
# Output-token ceiling.  D56: this value is only read on the *legacy env-only* path
# -- i.e. when config/models.toml is absent (see AGENT_MODELS_CONFIG below).  With
# models.toml present (the normal setup) the profile's own `max_tokens` wins and this
# line has no effect.  Code fallback when neither is set is 512.
MAX_TOKENS=4096

# Stage-1 Docling parse (chunk/embed are stage 2).
DOCLING_DO_OCR=true
# D1: how long a rebuild lock may live before another attempt takes it over
# (seconds, min 60).  A build killed midway used to block every later rebuild
# until the lock file was deleted by hand.
INDEX_BUILD_LOCK_TTL_S=3600

# Retrieval (used after stage-2 indexing is restored).
QUERY_PLANNING_ENABLED=true
QUERY_PLANNING_LLM_ENABLED=true
QUERY_PLANNING_MAX_SUBQUERIES=4
# RETRIEVAL_CANDIDATE_K is deliberately NOT listed: the code default (15, D30's
# rerank-pool shrink -- the pool size *is* the rerank cost) is the value we want.
# Pinning a number here silently overrides the code default for anyone who copies
# this file; set it in your own .env only if you have measured a reason to.
RETRIEVAL_FINAL_K=5
RETRIEVAL_RRF_K=60
RETRIEVAL_QUOTA_PER_QUERY=1

# Post-fusion cross-encoder rerank (order only; gate still uses dense cosine).
# Prefer the local ModelScope snapshot under data/models (avoids hub offline misses).
RERANK_ENABLED=true
RERANK_MODEL=/app/data/models/modelscope/models/BAAI--bge-reranker-v2-m3/snapshots/master
RERANK_MAX_LENGTH=512

# After embedding/Docling weights are warm in the mounted HF cache, keep offline
# so SentenceTransformer does not probe missing optional configs on huggingface.co.
HF_HUB_OFFLINE=1

# D49: host path bind-mounted to /root/.cache/huggingface in api+worker.
# Default is ${HOME}/.cache/huggingface (compose expands it), so normally you do
# NOT need to set this. Set it only when the cache lives elsewhere (e.g. a drive
# other than C:, or a shared cache dir). On Windows use a forward-slash path:
#   HF_CACHE_DIR=C:/Users/<you>/.cache/huggingface
# HF_CACHE_DIR=

# D50: build order matters. The Dockerfile is FROM ${BASE_IMAGE} - it is an
# incremental overlay, NOT a from-scratch build, so a base image must already
# exist locally before `docker compose build` can work:
#   1) pull/build the torch+docling+onnxruntime base and tag it as BOTH
#      document-qa-assistant-worker:latest and document-qa-assistant-api:latest
#      (compose passes BASE_IMAGE per service; both default to the worker tag);
#   2) then `docker compose build` (overlay: pydantic pin + onnxruntime-gpu).
# BASE_IMAGE is a compose build ARG, not a runtime env var - set it in the
# compose file / shell when building, not here.

# ReadMate agent (see .hermes/plans/*-readmate-agent-backend.md)
AGENT_DB_PATH=
AGENT_DEFAULT_MODE=deep
AGENT_MAX_STEPS=6
AGENT_MAX_GATE_BLOCKS=2
AGENT_HISTORY_TURNS=6
AGENT_TOOL_TEXT_CHARS=1200
AGENT_TOOL_MAX_HITS=5
AGENT_DIGEST_CHARS=600
# 批 D (D32): conversation history is admitted by token budget, not turn count.
# The budget is ``model context_length * this ratio``, clamped to [4k, 24k].
AGENT_HISTORY_CONTEXT_RATIO=0.30
# 批 D (D32): once older turns fall out of that window, compress them into a
# pointer-style session summary in the background (Celery).  0 disables it.
AGENT_SESSION_SUMMARY_ENABLED=1
# Dual-track retrieval routing: auto = the model decides (see plan 7.5).
AGENT_ROUTE_MODE=auto
# Model registry file; omit it to fall back to MODEL/BASE_URL/API_KEY above.
AGENT_MODELS_CONFIG=config/models.toml
# Credentials referenced from config/models.toml (never put keys in that file).
MAIN_API_KEY=
MAIN_BASE_URL=
CHEAP_API_KEY=
CHEAP_BASE_URL=
